{
  "expo": {
    "name": "SayItSimply",
    "slug": "SayItSimply",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "sayitsimply",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SayItSimply to use the camera"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SayItSimply to access your photos"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIdPermission": "Allow SayItSimply to use Face ID to log in"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIdPermission": "Allow SayItSimply to access Face ID secure store"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D1321",
          "dark": {
            "backgroundColor": "#0D1321"
          }
        }
      ],
      "expo-web-browser",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
